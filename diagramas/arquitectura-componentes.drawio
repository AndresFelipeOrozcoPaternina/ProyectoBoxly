        <mxCell id="frontBoundary" value="FRONTEND WEB — HTML / CSS / JavaScript" style="swimlane;html=1;startSize=32;rounded=1;fillColor=#eff6ff;swimlaneFillColor=#dbeafe;strokeColor=#60a5fa;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="270" height="390" as="geometry" /></mxCell>
