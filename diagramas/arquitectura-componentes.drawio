        <mxCell id="client" value="script.js&#xa;eventos y presentación&#xa;CATALOGO local + localStorage&#xa;fetch para contratar / cancelar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontSize=13;" vertex="1" parent="frontBoundary"><mxGeometry x="25" y="180" width="215" height="120" as="geometry" /></mxCell>
