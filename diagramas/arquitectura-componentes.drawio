        <mxCell id="factory" value="Factory Method&#xa;IPlanFactory / PlanFactory&#xa;variantes y descuentos de plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f97316;fontSize=13;" vertex="1" parent="apiBoundary"><mxGeometry x="300" y="300" width="235" height="90" as="geometry" /></mxCell>
