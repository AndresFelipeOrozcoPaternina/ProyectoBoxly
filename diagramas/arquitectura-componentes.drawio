        <mxCell id="controllers" value="Controladores REST&#xa;CajasController&#xa;SuscripcionesController&#xa;HTTP: /api/cajas, /api/suscripciones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#8b5cf6;fontSize=13;" vertex="1" parent="apiBoundary"><mxGeometry x="270" y="60" width="270" height="115" as="geometry" /></mxCell>
